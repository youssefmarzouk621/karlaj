# Storefront (/opt/app/.env-frontend). ${VARS} come from .env.

AUTH_URL=https://${DOMAIN}
ASSETS_BASE_URL=https://${DOMAIN}

# Keycloak client "brickart-frontend" (confidential) — see DEPLOY.md
AUTH_KEYCLOAK_ISSUER=https://auth.${DOMAIN}/realms/${KEYCLOAK_REALM}
AUTH_KEYCLOAK_ID=brickart-frontend
AUTH_KEYCLOAK_SECRET=${KEYCLOAK_FRONTEND_CLIENT_SECRET}
# openssl rand -base64 32 — must differ from the dashboard's
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

MOSAIC_SERVICE=mosaic-generator
MOSAIC_GENERATOR_API_URL=http://mosaic-generator:8002

# The dashboard applies schema changes; leave this off here.
RUN_MIGRATIONS=false
