# Traefik (/opt/traefik/.env)

# Same domain as /opt/app/.env — the wildcard certificate covers DOMAIN and
# *.DOMAIN, and the dashboard lives at https://traefik.DOMAIN
DOMAIN=example.com

# Cloudflare account that owns the DNS zone (My Profile → API Tokens → Global API Key)
CF_API_EMAIL=you@example.com
CF_API_KEY=change-me

# Let's Encrypt account email (defaults to CF_API_EMAIL)
ACME_EMAIL=

# Dashboard login. Generate with:  htpasswd -nbB admin 'your-password'
# Keep the single quotes — the hash contains $ signs.
TRAEFIK_DASHBOARD_USERS='admin:$2y$05$replace-with-htpasswd-output'
