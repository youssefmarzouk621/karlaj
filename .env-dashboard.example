# Admin dashboard (/opt/app/.env-dashboard). ${VARS} come from .env.

AUTH_URL=https://dashboard.${DOMAIN}
FRONTEND_URL=https://${DOMAIN}

# Keycloak client "brickart-dashboard" (confidential) — see DEPLOY.md
AUTH_KEYCLOAK_ISSUER=https://auth.${DOMAIN}/realms/${KEYCLOAK_REALM}
AUTH_KEYCLOAK_ID=brickart-dashboard
AUTH_KEYCLOAK_SECRET=${KEYCLOAK_DASHBOARD_CLIENT_SECRET}
# openssl rand -base64 32 — must differ from the frontend's
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
KEYCLOAK_ADMIN_ROLE=brickart-admin

DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}

# Schema changes on start: `prisma migrate deploy` when database/prisma/migrations
# exists, otherwise `prisma db push` (refuses changes that would lose data).
RUN_MIGRATIONS=true
DB_PUSH_ON_START=true
