# =============================================================================
# BrickArt — global settings (/opt/app/.env)
# Read by Docker Compose itself; the .env-* files reference these as ${VAR}.
# =============================================================================

# The one line that defines the domain. Everything else is derived from it:
#   https://DOMAIN  https://dashboard.DOMAIN  https://auth.DOMAIN
DOMAIN=example.com

# --- MySQL (shared by every service) -----------------------------------------
# Use URL-safe passwords (letters, digits, - _ .): they are embedded in DATABASE_URL.
# Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=brickart
MYSQL_USER=brickart
MYSQL_PASSWORD=change-me

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=brickart
# Secrets of the brickart-frontend / brickart-dashboard clients. Written into the
# realm on first import (realm-config/brickart-realm.json) and used by the apps.
# Generate with: openssl rand -hex 32
KEYCLOAK_FRONTEND_CLIENT_SECRET=change-me
KEYCLOAK_DASHBOARD_CLIENT_SECRET=change-me

# --- API keys ----------------------------------------------------------------
ANTHROPIC_API_KEY=
