// Shared Prisma schema for the whole LEGO-mosaic platform.
// Consumed by the dashboard (manages) and the frontend (reads sizes) via the
// @lego/database package, and read directly over MySQL by the Python
// mosaic-generator service. One schema, one generated client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Marketing content (moved verbatim from the dashboard's former schema)
// ---------------------------------------------------------------------------

model HeroContent {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  titleAccent String   @map("title_accent") @db.VarChar(255)
  subtitle    String   @db.Text
  ctaText     String   @map("cta_text") @db.VarChar(100)
  ctaLink     String   @map("cta_link") @db.VarChar(255)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("hero_content")
}

model Feature {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  description String   @db.Text
  icon        String   @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("features")
}

model PricingPlan {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  price       String   @db.VarChar(50)
  period      String   @default("") @db.VarChar(20)
  description String   @db.Text
  featured    Boolean  @default(false)
  ctaText     String   @map("cta_text") @db.VarChar(100)
  ctaLink     String   @map("cta_link") @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  features PricingFeature[]

  @@map("pricing_plans")
}

model PricingFeature {
  id        String @id @default(uuid())
  planId    String @map("plan_id")
  text      String @db.VarChar(255)
  sortOrder Int    @default(0) @map("sort_order")

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("pricing_features")
}

// ---------------------------------------------------------------------------
// Mosaic configuration (managed in the dashboard, read by frontend + generator)
// ---------------------------------------------------------------------------

/// App-wide key/value settings (feature flags etc.), one row per key. E.g.
/// `custom_size_enabled` = "true"/"false" gates the frontend's free custom-size
/// inputs and drag-resize. Absent key ⇒ treated as enabled (current behavior).
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// A selectable mosaic size (in studs). Disabled sizes show as "coming soon".
/// `price` is the order price for this size, in millimes (1 TND = 1000
/// millimes); `displayPrice` is the admin-entered formatted string shown to
/// customers (e.g. "140TND"). Both are 0/empty until an admin sets them.
model MosaicSize {
  id           String   @id @default(uuid())
  width        Int
  height       Int
  label        String?  @db.VarChar(100)
  enabled      Boolean  @default(true)
  price        Int      @default(0)
  displayPrice String   @default("") @map("display_price") @db.VarChar(50)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  artworks Artwork[]

  @@unique([width, height])
  @@map("mosaic_sizes")
}

/// A configurable extra charge added once per order (shipping, packaging,
/// services, ...). Admin-managed on the dashboard's Pricing page; admin can
/// add as many as needed. `price` is in millimes, `displayPrice` is the
/// admin-entered formatted string shown to customers (e.g. "8TND").
model ExtraCharge {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  price        Int      @default(0)
  displayPrice String   @default("") @map("display_price") @db.VarChar(50)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cartCharges CartExtraCharge[]

  @@map("extra_charges")
}

/// A named color palette. Exactly one palette is enabled at a time (enforced
/// app-side in the dashboard). The generator builds artwork from the enabled one.
/// `priceMultiplier` scales a mosaic size's base price for artworks generated
/// with this palette (e.g. 1.1 = +10%); admin-configurable on the dashboard's
/// Pricing page.
model Palette {
  id              String   @id @default(uuid())
  name            String   @unique @db.VarChar(100)
  enabled         Boolean  @default(false)
  priceMultiplier Float    @default(1) @map("price_multiplier")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  colors   Color[]
  artworks Artwork[]

  @@map("palettes")
}

/// A single color in a palette. Stores both hex and r/g/b for convenience.
/// `external` marks a color that is NOT part of the supplier's own range —
/// currently the neutrals (white/grays/black), which the PX range doesn't
/// carry but which the generator needs: without a light neutral, every white
/// in a photo lands on a tinted brick and high-key images render purple or
/// beige. These have to be sourced separately, so they're flagged for ordering.
model Color {
  id        String   @id @default(uuid())
  paletteId String   @map("palette_id")
  name      String   @db.VarChar(100)
  hex       String   @db.VarChar(7)
  r         Int
  g         Int
  b         Int
  code      String?  @db.VarChar(50) // optional supplier code, e.g. "B01"
  external  Boolean  @default(false) // sourced outside the supplier's range
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  palette   Palette         @relation(fields: [paletteId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]

  @@index([paletteId])
  @@map("colors")
}

/// What a Part is: a BRICK is tiled into the mosaic by the generator; a BASE is
/// the plate the mosaic is built on (e.g. the 16x16 Technic plate 65803 whose
/// side holes let several bases pin together). Bases are never placed by the
/// generator.
enum PartKind {
  BRICK
  BASE
}

/// A brick/plate the generator may use, or a base (see PartKind). `variable` on the 1x1 part is the max
/// fraction of the artwork that may be 1x1 (e.g. 0.35); null elsewhere.
/// `weightGrams` is the weight of a single piece, used to convert between the
/// piece count and purchased weight of inventory. Unique on the BrickLink
/// `partId`, not on the footprint: two parts can share a size (e.g. the 1x1
/// square plate 3024 and the 1x1 round plate 4073).
model Part {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  partId      String   @unique @map("part_id") @db.VarChar(50)
  kind        PartKind @default(BRICK)
  width       Int
  height      Int
  enabled     Boolean  @default(true)
  variable    Float?
  weightGrams Float?   @map("weight_grams")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory InventoryItem[]

  // Which bricks fit on which base. Only meaningful BRICK <-> BASE: a brick's
  // `compatibleBases`, a base's `compatibleBricks` (the same link, both sides).
  compatibleBases  Part[] @relation("PartBaseCompatibility")
  compatibleBricks Part[] @relation("PartBaseCompatibility")

  @@index([width, height])
  @@map("parts")
}

/// On-hand stock of a specific brick shape in a specific color. Keyed on
/// (part, color); each palette is a distinct physical color line, so the FK is
/// to the per-palette Color row. `quantity` (pieces) and `grams` (weight) are
/// stored together — the dashboard derives one from the other via the part's
/// `weightGrams`. The generator will later cap placements by these counts.
model InventoryItem {
  id        String   @id @default(uuid())
  partId    String   @map("part_id") // FK -> Part.id (uuid), not the BrickLink id
  colorId   String   @map("color_id") // FK -> Color.id
  quantity  Int      @default(0) // pieces on hand
  grams     Float    @default(0) // weight on hand (grams)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  part  Part  @relation(fields: [partId], references: [id], onDelete: Cascade)
  color Color @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([partId, colorId])
  @@index([colorId])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Cart (anonymous, cookie-based cart of generated artworks)
// ---------------------------------------------------------------------------

/// Lifecycle of a generated artwork: INITIAL right after generation, LOCKED
/// while sitting in a cart, REMOVED once taken back out. A future cron job
/// deletes INITIAL/REMOVED rows that were never checked out.
enum ArtworkStatus {
  INITIAL
  LOCKED
  REMOVED
}

/// A generated mosaic, persisted right after `/process` succeeds so it can be
/// added to a cart later. Mirrors the mosaic-generator's response shape.
/// `sizeId` links to the matching catalog MosaicSize (for direct price access
/// via the relation) when width/height match one; null for custom sizes that
/// don't match any catalog entry. `width`/`height` stay on the row regardless,
/// since custom-size artworks have no MosaicSize to fall back on. `paletteId`
/// is the palette that was enabled when this artwork was generated (the
/// generator always builds from the single enabled palette) — used together
/// with the size to price the artwork when it's added to a cart.
model Artwork {
  id         String        @id @default(uuid())
  jobId      String?       @unique @map("job_id") @db.VarChar(100)
  sizeId     String?       @map("size_id")
  paletteId  String?       @map("palette_id")
  width      Int
  height     Int
  grid       Json
  placements Json
  partsList  Json          @map("parts_list")
  totalParts Int           @map("total_parts")
  bags       Json
  status     ArtworkStatus @default(INITIAL)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  size     MosaicSize?    @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  palette  Palette?       @relation(fields: [paletteId], references: [id], onDelete: SetNull)
  cartItem CartItem?
  images   ArtworkImage[]

  @@index([status])
  @@index([sizeId])
  @@index([paletteId])
  @@map("artworks")
}

/// Which rendered variant an ArtworkImage row is: MAIN is the high-fidelity
/// render; PREVIEW_1/PREVIEW_2 are progressively smaller sizes for list/
/// thumbnail contexts (e.g. the cart).
enum ArtworkImageKind {
  MAIN
  PREVIEW_1
  PREVIEW_2
}

/// A PNG rendered from an artwork's placements at creation time and written
/// to disk (`frontend/public/uploads/<artworkId>/<file>.png`), so it doesn't
/// need to be recomputed on a `<canvas>` client-side every time it's shown.
/// `url` is a full HTTP URL (ASSETS_BASE_URL + the served path), stored
/// ready-to-use rather than assembled at read time.
model ArtworkImage {
  id        String           @id @default(uuid())
  artworkId String           @map("artwork_id")
  kind      ArtworkImageKind
  url       String           @db.VarChar(500)
  width     Int
  height    Int
  createdAt DateTime         @default(now()) @map("created_at")

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([artworkId, kind])
  @@index([artworkId])
  @@map("artwork_images")
}

/// An anonymous cart identified by an opaque token stored in a browser
/// cookie (no user accounts yet). Created lazily on first "Add to cart".
/// `subtotal` (sum of the items' frozen prices) and `total` (subtotal plus the
/// applied extra charges) are stored in millimes rather than recomputed at read
/// time: they're written by `repriceCart` inside the same transaction as every
/// cart mutation, so the row always holds the amount the customer was shown.
/// The charges making up `total - subtotal` are itemized in `charges`.
model Cart {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(64)
  subtotal  Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   CartItem[]
  charges CartExtraCharge[]

  @@map("carts")
}

/// One extra charge (shipping, packaging, ...) as applied to a cart, snapshotted
/// on every reprice. `name`/`price`/`displayPrice` are copied from the
/// ExtraCharge row so the line keeps reading the way the customer saw it even
/// after an admin renames, reprices, disables or deletes the source charge,
/// while `extraChargeId` keeps the link back to that row for auditing (null
/// once it's deleted).
model CartExtraCharge {
  id            String   @id @default(uuid())
  cartId        String   @map("cart_id")
  extraChargeId String?  @map("extra_charge_id")
  name          String   @db.VarChar(100)
  price         Int      @default(0)
  displayPrice  String   @default("") @map("display_price") @db.VarChar(50)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  extraCharge ExtraCharge? @relation(fields: [extraChargeId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([extraChargeId])
  @@map("cart_extra_charges")
}

/// One artwork sitting in a cart. `artworkId` is unique — an artwork lives
/// in at most one cart at a time. `price` (millimes) is computed once, when
/// the artwork is added to the cart, as the artwork's size price times its
/// palette's price multiplier — it does not change if the admin edits pricing
/// afterward.
model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  artworkId String   @unique @map("artwork_id")
  price     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Site images (managed in the dashboard, served by the frontend)
// ---------------------------------------------------------------------------

/// An admin-uploaded image for a named slot on the public site (see
/// SITE_IMAGE_SLOTS in src/siteImages.ts). One row per slot; no row means the
/// frontend falls back to its bundled default artwork. The bytes live in the
/// database so the dashboard and frontend need no shared filesystem.
model SiteImage {
  slot      String   @id @db.VarChar(50)
  mimeType  String   @map("mime_type") @db.VarChar(50)
  data      Bytes    @db.LongBlob
  alt       String   @default("") @db.VarChar(255)
  /// Optional caption, for slots that show one (e.g. the gallery cards).
  title     String   @default("") @db.VarChar(100)
  meta      String   @default("") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_images")
}
